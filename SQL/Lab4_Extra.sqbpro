<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="cinema.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="177"/><column_width id="1" width="0"/><column_width id="2" width="66"/><column_width id="3" width="2452"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="screenings" custom_title="0" dock_id="2" table="4,10:mainscreenings"/><dock_state state="000000ff00000000fd000000010000000200000341000003b7fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000000003410000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000000003410000011e00ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="movies" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="263"/><column index="3" value="86"/><column index="4" value="61"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="screenings" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="80"/><column index="2" value="55"/><column index="3" value="62"/><column index="4" value="96"/><column index="5" value="96"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">--E1
SELECT * FROM products
WHERE category in ('Clothing','Accessories') AND (price BETWEEN 150 AND 500) --150 and 500 are included in range
ORDER BY price DESC;
--E2
SELECT * FROM orders
WHERE (NOT status = 'cancelled') AND (order_date BETWEEN '2026-02-01' AND '2026-02-28');
--E3
SELECT o.order_id, p.name, oi.quantity, oi.quantity * oi.unit_price AS line_total
FROM order_items oi
JOIN orders o ON o.order_id = oi.order_id
JOIN products p ON p.product_id = oi.product_id
WHERE line_total &gt; 500
ORDER BY line_total DESC;
--E4
SELECT DISTINCT(c.customer_id), c.first_name
FROM customers c
JOIN orders o ON o.customer_id = c.customer_id
WHERE c.city in ('Uppsala','Stockholm')
GROUP BY c.customer_id, c.first_name;
--E5
--INSERT
	INTO customers(first_name, last_name, email, city, joined_date)
	VALUES('Leo', 'Falk', 'leo@falk.com', 'Uppsala', CURRENT_DATE);
SELECT * FROM order_items
SELECT * FROM orders
select * FROM products
--INSERT
	INTO orders(customer_id, order_date, status)
	VALUES(11, CURRENT_DATE, 'new');
--INSERT
	INTO order_items(order_id, product_id, quantity, unit_price)
	VALUES(101, 1, 1, 599),
		(101, 9, 2, 129);
SELECT p.name AS name, oi.quantity as quantity, oi.quantity * oi.unit_price AS price
FROM order_items oi
JOIN products p ON p.product_id = oi.product_id
WHERE oi.order_id = 101
UNION ALL --adding total row since it's a receipt
SELECT 'Total' as name, SUM(oi.quantity) AS quantity , SUM(oi.quantity * oi.unit_price) AS price
FROM order_items oi
JOIN products p ON p.product_id = oi.product_id
WHERE oi.order_id = 101;
--E6
--UPDATE
	orders
	SET status = 'cancelled'
	WHERE order_id = 12;
--UPDATE
	products AS p
	SET stock = stock + c.quantity
	FROM (
		SELECT product_id, quantity
		FROM order_items WHERE order_id = 12
	) c
	WHERE c.product_id = p.product_id;
--E7
--DELETE
	FROM products WHERE products.name = 'Hoodie Black';
/*
Execution finished with errors.
Result: FOREIGN KEY constraint failed
At line 58:
DELETE FROM products WHERE products.name = 'Hoodie Black'
*/
/*
There's a foreign key preventing us from deleting it, for good reason.
There are already orders + order_items with 'Hoodie Black' in them
Deleting the item would not be a good idea since that would alter the existing orders
(they would reference a product that doesn't exist).
What we could do is set its stock to 0 and require stock to be &gt; 0 for us to sell an item.
Or we could introduce a new column that indicates if the item is for sale or not.
*/
--E8
--ALTER
	TABLE products
	ADD discount_percent REAL DEFAULT 0 CHECK(discount_percent BETWEEN 0 AND 90);
--UPDATE
	products
	SET discount_percent = 20
	WHERE category = 'Shoes';
SELECT *, price * (1-discount_percent/100) AS discounted_price FROM products;
--E9
SELECT p.name, o.order_date
FROM order_items oi
JOIN orders o ON oi.order_id = o.order_id
RIGHT JOIN products p ON p.product_id = oi.product_id
ORDER BY p.name;
--E10
SELECT DISTINCT(c.customer_id), c.first_name
FROM customers c
JOIN orders o ON o.customer_id = c.customer_id
JOIN order_items oi ON oi.order_id = o.order_id
JOIN products p ON p.product_id = oi.product_id
WHERE p.category = 'Shoes';
--E11
SELECT c1.first_name, c2.first_name
FROM customers c1
JOIN customers c2 ON c1.city = c2.city AND c1.customer_id &lt; c2.customer_id;
--E12
--UPDATE
	products
	SET price = 649
	WHERE products.name = 'Hoodie Black';
SELECT oi.order_id,
	p.name,
	oi.quantity * oi.unit_price AS paid_price,
	oi.quantity * p.price AS todays_price
FROM order_items oi
JOIN products p ON p.product_id = oi.product_id
WHERE paid_price != todays_price;
--E13
--CREATE
	TABLE movies(
		movie_id INTEGER PRIMARY KEY,
		title TEXT NOT NULL,
		movie_length INTEGER CHECK(movie_length &gt;= 0),
		age_limit INTEGER CHECK(age_limit in (0, 7, 11, 15))
	);
--CREATE
	TABLE screenings(
		screening_id INTEGER PRIMARY KEY,
		salon_id INTEGER NOT NULL,
		movie_id INTEGER NOT NULL,
		screening_date date,
		screening_time time,
		PERIOD FOR BUSINESS_TIME (start_ts, end_ts),
		CONSTRAINT fk_movie FOREIGN KEY (movie_id) REFERENCES movies(movie_id)
	);
--CREATE
	TABLE customers(
		customer_id INTEGER PRIMARY KEY,
		name TEXT NOT NULL
	);
--CREATE
	TABLE tickets(
		ticket_id INTEGER PRIMARY KEY,
		customer_id INTEGER NOT NULL,
		screening_id INTEGER NOT NULL,
		seat_number INTEGER CHECK(seat_number &gt; 0),
		CONSTRAINT uc_seat UNIQUE(screening_id, seat_number),
		CONSTRAINT fk_customer FOREIGN KEY (customer_id) REFERENCES customers(customer_id),
		CONSTRAINT fk_screening FOREIGN KEY (screening_id) REFERENCES screenings(screening_id)		
	);
--INSERT
	INTO movies(title, movie_length, age_limit)
	VALUES('Ghostbusters',105, 11),
		('Big Trouble in Little China',99, 11),
		('Monthy Python and the Holy Grail', 91, 11);
--INSERT
	INTO screenings(salon_id, movie_id, screening_date, screening_time)
	VALUES(1, 1, CURRENT_DATE, '15:00:00'),
		(2,2, CURRENT_DATE, '15:00:00'),
		(3,3, CURRENT_DATE, '15:00:00'),
		(1,2, CURRENT_DATE, '18:00:00');
--INSERT
	INTO customers(name)
	VALUES('Ada'),('Bob'),('Cecil');
--INSERT
	INTO tickets(customer_id, screening_id, seat_number)
	VALUES(1, 1, 1),
		(1, 1, 2),
		(1, 1, 3),
		(1, 4, 1),
		(2, 2, 1),
		(3, 3, 1);
SELECT s.screening_date, s.screening_time, m.title
FROM screenings s
JOIN movies m on m.movie_id = s.movie_id
ORDER BY s.screening_date, s.screening_time;

SELECT m.title, s.screening_date, s.screening_time, t.seat_number, c.name
FROM tickets t
JOIN screenings s ON s.screening_id = t.screening_id
JOIN customers c ON c.customer_id = t.customer_id
JOIN movies m ON m.movie_id = s.movie_id
ORDER BY s.screening_date, s.screening_time, s.screening_id;

SELECT m.title, s.screening_date, s.screening_time
FROM screenings s
JOIN movies m ON m.movie_id = s.movie_id
JOIN tickets t ON t.screening_id = s.screening_id
WHERE t.screening_id = NULL;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
