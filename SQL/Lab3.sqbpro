--3.10
/*
Unclear what you are trying to accomplish.
I'm assuming it's a table of students and each student can have multiple phone numbers and multiple courses
Problems:
1) Having multiple phone numbers in one column is a problem, better to have a seperate table for phone_numbers where each phone_number is linked to a student_id
2) Having multiple columns for courses is a problem, better to have a seperate table for courses and then a middle table for linking student_id to course_id for each student taking a course
*/
--3.11
/*
There's multiple rows with the same customer name, customer email, customer city
Also there are multiple products in the same product column which is a problem in itself as it is difficult to read data when it's formatted like that
Further there's just a single total for all the items, meaning it's difficult to do a partial refund as we don't know how much was paid for each item
To fix this we should:
1) Make a seperate Table for customers (for things like customer name, emaii, city) and just have customerID in the order_sheet table
2) have a seperate Table for products
3) have a seperate table order_sheet_items where we have order_id and product_id and quantity and price
*/
--3.12
--customer_email does not belong in the same table as orders, we would have one email for every order, it belongs in a customer TABLE
--3.13
--Again... I'm assuming you don't want me to send a hand drawn picture to GIT???
--3.14
/*
By the description I'm assuming each lesson has exactly 1 student and exactly 1 teacher
so...
 student - lesson would be 1:N
 teacher - lesson would be 1:N
 student - teacher would be N:M (need middle table such as lesson)
 teacher - instrument would be N:M (need middle table to track which teacher can teach which instrument
 maybe we also have student - instrument N:M for which student is learning each instrument so middle table there too
 lesson - room would be 1:N
 date and time are just columns in lesson
*/
--3.15
-- Hand drawn...
--3.16
--CREATE
	TABLE students(
		student_id INTEGER PRIMARY KEY,
		name TEXT NOT NULL		
	);
--INSERT
	INTO students(name)
	VALUES('Ada'), ('Bob');	
--CREATE
	TABLE teachers(
		teacher_id INTEGER PRIMARY KEY,
		name TEXT NOT NULL
	);
--INSERT
	INTO teachers(name)
	VALUES('Cecil'), ('Dana');
--CREATE
	TABLE instruments(
		instrument_id INTEGER PRIMARY KEY,
		name TEXT NOT NULL
	);
--INSERT
	INTO instruments(name)
	VALUES('Guitar'), ('Drums');
--CREATE
	TABLE teacher_instruments(
		teacher_instrument_id INTEGER PRIMARY KEY,
		teacher_id INTEGER NOT NULL,
		instrument_id INTEGER NOT NULL,
		CONSTRAINT fk_teacher FOREIGN KEY (teacher_id) REFERENCES teachers(teacher_id) ON DELETE CASCADE
	);
--INSERT
	INTO teacher_instruments(teacher_id, instrument_id)
	VALUES(1, 1),(2, 2)
--CREATE
	TABLE student_instruments(
		student_instrument_id INTEGER PRIMARY KEY,
		student_id INTEGER NOT NULL,
		instrument_id INTEGER NOT NULL,
		CONSTRAINT fk_student FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE
	);
--INSERT
	INTO student_instruments(student_id, instrument_id)
	VALUES(1, 2),(2, 1)
--CREATE
	TABLE lessons(
		lesson_id INTEGER PRIMARY KEY,
		room_id INTEGER NOT NULL, --If room needs more data to it a seperate table for room could be added with a foreign key referencing it
		teacher_id INTEGER NOT NULL,
		student_id INTEGER NOT NULL,
		instrument_id INTEGER NOT NULL,
		lesson_date date,
		lesson_time time,
		CONSTRAINT fk_student FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE,
		CONSTRAINT fk_teacher FOREIGN KEY (teacher_id) REFERENCES teachers(teacher_id) ON DELETE CASCADE,
		CONSTRAINT fk_instrument FOREIGN KEY (instrument_id) REFERENCES instruments(instrument_id) ON DELETE CASCADE
	);
--INSERT
	INTO lessons(room_id, teacher_id, student_id, instrument_id, lesson_date, lesson_time)
	VALUES(1, 1, 2, 1, '2026-10-08', '08:00:00'),
		(3, 1, 2, 1, '2026-10-15', '08:00:00');



